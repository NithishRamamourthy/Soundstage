<Application x:Class="Soundstage.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>

        <!-- ===================================================================== -->
        <!--  Soundstage OLED design system                                        -->
        <!--  Pure black surfaces, violet accent, thin borders, soft glows.        -->
        <!--  Every key a page may use is defined in this file.                    -->
        <!-- ===================================================================== -->

        <!-- ============================= Palette ============================= -->
        <SolidColorBrush x:Key="SfBgBrush" Color="#000000" />
        <SolidColorBrush x:Key="SfSurfaceBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="SfSurfaceAltBrush" Color="#131317" />
        <SolidColorBrush x:Key="SfSurfaceHoverBrush" Color="#1B1B21" />
        <SolidColorBrush x:Key="SfStrokeBrush" Color="#26262E" />
        <SolidColorBrush x:Key="SfStrokeSoftBrush" Color="#191920" />
        <SolidColorBrush x:Key="SfTextBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="SfTextSecondaryBrush" Color="#A2A2AE" />
        <SolidColorBrush x:Key="SfTextTertiaryBrush" Color="#63636E" />
        <SolidColorBrush x:Key="SfAccentBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="SfAccent2Brush" Color="#22D3EE" />
        <SolidColorBrush x:Key="SfAccentSoftBrush" Color="#1A1430" />
        <SolidColorBrush x:Key="SfSuccessBrush" Color="#30D158" />
        <SolidColorBrush x:Key="SfWarningBrush" Color="#FFD60A" />
        <SolidColorBrush x:Key="SfDangerBrush" Color="#FF453A" />

        <!-- Accent gradient: violet -> indigo, top-left to bottom-right.
             Used by primary buttons, switches and slider fills. Hover must
             never swap this for a flat grey. -->
        <LinearGradientBrush x:Key="SfAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#5B5BF7" Offset="1" />
        </LinearGradientBrush>

        <!-- Soft radial glow (45% opacity centre fading to transparent). -->
        <RadialGradientBrush x:Key="SfAccentGlowBrush">
            <GradientStop Color="#738B5CF6" Offset="0" />
            <GradientStop Color="#738B5CF6" Offset="0.55" />
            <GradientStop Color="#008B5CF6" Offset="1" />
        </RadialGradientBrush>

        <!-- ================== Fluent theme brush overrides =================== -->
        <!-- Keeps the default Fluent control templates on-theme. -->
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A2A2AE" />
        <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#63636E" />
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26262E" />
        <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#3A3A44" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#000000" />
        <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#30D158" />
        <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFD60A" />
        <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#0C1F12" />
        <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#231D07" />
        <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#2A0E0C" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#131317" />
        <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1B1B21" />
        <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#191920" />

        <!-- ============================ Typography =========================== -->
        <FontFamily x:Key="SfFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="SfFontBody">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Body font for every TextBlock that has no explicit style.
             Deliberately sets the font family ONLY: a foreground setter here
             would break text that inherits its colour from buttons and nav items. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ==================== Legacy keys (still used) ===================== -->
        <!-- Same keys as before the redesign, restyled to the OLED look. -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SfSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SfStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontDisplay}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
        </Style>

        <!-- Pill on/off switch. Checked track uses the accent gradient; hover
             brightens with a white sheen, never grey. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11"
                                    Background="{StaticResource SfSurfaceAltBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource ControlStrongStrokeColorDefaultBrush}" />
                            <Border x:Name="Shine" CornerRadius="11" Background="#FFFFFF"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left"
                                     Margin="3,0,0,0" Fill="{StaticResource SfTextSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SfAccentGradientBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SfAccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SfAccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Shine" Property="Opacity" Value="0.14" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Shine" Property="Opacity" Value="0.28" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Surfaces ============================= -->

        <!-- Card: surface panel with hairline border. -->
        <Style x:Key="SfCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SfSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SfStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SfDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource SfStrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="SfChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SfSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SfStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- =========================== Headings ============================== -->

        <Style x:Key="SfH1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontDisplay}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
        </Style>

        <Style x:Key="SfH2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontDisplay}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
        </Style>

        <Style x:Key="SfEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextTertiaryBrush}" />
        </Style>

        <!-- ============================ Buttons ============================== -->

        <!-- Primary: accent gradient fill, white text. Hover = brightness sheen,
             pressed = reduced opacity. Never grey. -->
        <Style x:Key="SfPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" Background="{StaticResource SfAccentGradientBrush}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="Shine" CornerRadius="10" Background="#FFFFFF"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.15" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary: inset surface with hairline border. -->
        <Style x:Key="SfSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{StaticResource SfSurfaceAltBrush}"
                                BorderBrush="{StaticResource SfStrokeBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost: transparent until hover. -->
        <Style x:Key="SfGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SfTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger: outlined in translucent red, transparent fill. -->
        <Style x:Key="SfDangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SfDangerBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="#66FF453A" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FF453A" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SfDangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button: 32x32, for window caption buttons. -->
        <Style x:Key="SfIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource SfTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alias so the legacy DynamicResource AccentButtonStyle keeps working
             and renders as the primary gradient button. -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SfPrimaryButton}" />

        <!-- =========================== ComboBox ============================== -->
        <!-- Full OLED template: the Fluent chrome paints a light-theme fill that
             ignores app brush overrides, so the shell, the chevron and the
             dropdown are drawn here. Non-editable combos only (all of ours). -->
        <Style x:Key="SfComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SfSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SfStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />

                            <ToggleButton x:Name="Toggle" Focusable="False" IsTabStop="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <Viewbox Width="11" Height="11" Margin="0,0,13,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Path Data="M1,3 L6,8 L11,3" Fill="Transparent"
                                      Stroke="{StaticResource SfTextSecondaryBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" VerticalOffset="6"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        CornerRadius="12" Padding="4"
                                        Background="{StaticResource SfSurfaceAltBrush}"
                                        BorderBrush="{StaticResource SfStrokeBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource SfAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown items: rounded, dark hover, accent-soft selection. Implicit
             so plain ComboBoxes pick it up too. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfAccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Sliders ============================== -->

        <!-- Shared thumb: 16px white circle with a 3px accent ring. -->
        <Style x:Key="SfSliderThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Width="16" Height="16"
                                     Fill="{StaticResource TextOnAccentFillColorPrimaryBrush}"
                                     Stroke="{StaticResource SfAccentBrush}" StrokeThickness="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal slider: 4px rounded track, accent gradient fill on the
             left part, no tick marks. -->
        <Style x:Key="SfSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" MinHeight="20">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource SfSurfaceAltBrush}" />
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource SfAccentGradientBrush}"
                                                        Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SfSliderThumb}" Width="16" Height="16" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical slider (equalizer): same look rotated; set
             Orientation="Vertical" and a Height on the control when using it. -->
        <Style x:Key="SfVerticalSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" VerticalAlignment="Stretch"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource SfSurfaceAltBrush}" />
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource SfAccentGradientBrush}"
                                                        Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SfSliderThumb}" Width="16" Height="16" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================== ProgressBar =========================== -->
        <!-- 5px pill: PART_Track inset, PART_Indicator accent gradient. -->
        <Style x:Key="SfProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource SfAccentGradientBrush}" />
            <Setter Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5"
                                    Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2.5"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndeterminatePulse">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.35" To="0.9" Duration="0:0:0.8"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="IndeterminatePulse" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================== Navigation ============================ -->

        <!-- Nav list: transparent ListBox, no border, no focus rectangle.
             Items automatically get the SfNavItem look. -->
        <Style x:Key="SfNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SfTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="10" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- 3px accent bar, only visible when selected. -->
                                <Border x:Name="AccentBar" Width="3" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Margin="0,10,0,10"
                                        Background="{StaticResource SfAccentGradientBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfAccentSoftBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SfNavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SfNavItem}" />
        </Style>

        <!-- ======================== Segmented control ======================== -->
        <!-- RadioButton used as a segment pill. GroupName on each segment. -->
        <Style x:Key="SfSegmentedItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SfTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="9" Background="Transparent"
                                BorderBrush="{StaticResource SfStrokeBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfSurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SfAccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SfAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ TabControl =========================== -->
        <!-- Headerless: shows only the selected content. The TabPanel is kept
             at zero height (clipped) so item containers still get realised and
             SelectedIndex / SelectedContent keep working when TabItems are
             declared in XAML and driven from the nav rail. -->
        <Style x:Key="SfTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="0" ClipToBounds="True"
                                    Focusable="False" IsHitTestVisible="False">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedTabHost" Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== Implicit chrome parts ====================== -->

        <!-- ScrollBar: 8px, transparent track, rounded #2E2E38 thumb, no arrows. -->
        <Style x:Key="SfScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SfScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#2E2E38" CornerRadius="3" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource SfScrollBarPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource SfScrollBarPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SfScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource SfScrollBarPageButton}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource SfScrollBarPageButton}" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SfScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTip: dark inset panel, hairline border, rounded. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SfSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SfTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SfStrokeBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource SfFontBody}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalOffset" Value="0" />
            <Setter Property="VerticalOffset" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
