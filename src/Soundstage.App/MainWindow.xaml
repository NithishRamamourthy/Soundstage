<Window x:Class="Soundstage.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soundstage.UI.Views"
        Title="Soundstage" Width="1220" Height="840" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SfBgBrush}" Foreground="{DynamicResource SfTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource SfIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A1210" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SfBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A faint accent bloom keeps the black from feeling flat. -->
        <Border Grid.RowSpan="2" Width="620" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="40,-170,0,0" Opacity="0.20" IsHitTestVisible="False"
                Background="{StaticResource SfAccentGlowBrush}" />

        <!-- Title bar -->
        <Grid Grid.Row="0" Margin="20,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource SfAccentGradientBrush}">
                    <Viewbox Width="19" Height="19">
                        <Path Data="M2,10 C5,3 8,3 10,10 C12,17 15,17 18,10"
                              Stroke="#FFFFFF" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Border>
                <TextBlock Text="Soundstage" Margin="11,0,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource SfTextBrush}" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="999" VerticalAlignment="Center"
                        Background="{StaticResource SfAccentSoftBrush}" BorderBrush="{StaticResource SfStrokeBrush}"
                        BorderThickness="1">
                    <TextBlock Text="OLED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SfAccentBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Margin="0,0,10,0" Padding="11,5" CornerRadius="999"
                        Background="{StaticResource SfSurfaceAltBrush}" BorderBrush="{StaticResource SfStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SfTextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                            <Setter Property="Fill" Value="{StaticResource SfSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                            <Setter Property="Fill" Value="{StaticResource SfWarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                            <Setter Property="Fill" Value="{StaticResource SfDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource SfTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SfIconButton}" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise"
                        AutomationProperties.Name="Minimise">
                    <Viewbox Width="12" Height="12">
                        <Path Data="M2,6 H12" Stroke="{StaticResource SfTextSecondaryBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource SfIconButton}" Click="Maximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximise or restore"
                        AutomationProperties.Name="Maximise or restore">
                    <Viewbox Width="12" Height="12">
                        <Path x:Name="MaximizeGlyph" Data="M2,2 H10 V10 H2 Z"
                              Stroke="{StaticResource SfTextSecondaryBrush}" StrokeThickness="1.3"
                              StrokeLineJoin="Miter" />
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <Viewbox Width="12" Height="12">
                        <Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="{StaticResource SfTextSecondaryBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation rail and pages -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="14,6,4,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" Style="{StaticResource SfNavList}"
                         ItemContainerStyle="{StaticResource SfNavItem}"
                         SelectedIndex="{Binding Page, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem AutomationProperties.Name="Spatial audio">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.5" />
                            </Viewbox>
                            <TextBlock Text="Spatial audio" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Headphones">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M3,12 V10 A7,7 0 0 1 17,10 V12 M3,12 H6 V17 H4 A1,1 0 0 1 3,16 Z M17,12 H14 V17 H16 A1,1 0 0 0 17,16 Z"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="Headphones" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                                <Path Data="M10,6 A4,4 0 1 1 9.99,6 M10,1 V3 M10,17 V19 M1,10 H3 M17,10 H19 M3.6,3.6 L5,5 M15,15 L16.4,16.4 M16.4,3.6 L15,5 M5,15 L3.6,16.4"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="10,0,10,0">
                    <Border Style="{StaticResource SfCard}" Margin="0,0,0,14" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Spatial audio" Style="{StaticResource RowLabel}" />
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Spatial audio" />
                            </Grid>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SfDivider}" Margin="0,0,0,12" />
                    <TextBlock Text="HEAD TRACKING" Style="{StaticResource SfEyebrow}" />
                    <TextBlock Text="{Binding TrackerText}" FontSize="12" Margin="0,2,0,14"
                               Foreground="{StaticResource SfTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                    <TextBlock Text="OLED edition" Style="{StaticResource Caption}"
                               Foreground="{StaticResource SfTextTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="Tabs" Grid.Column="1" Margin="8,6,14,0"
                        Style="{StaticResource SfTabControl}"
                        SelectedIndex="{Binding Page, Mode=TwoWay}">
                <TabItem>
                    <views:SpatialPage />
                </TabItem>
                <TabItem>
                    <views:HeadphonesPage DataContext="{Binding Headphones}" />
                </TabItem>
                <TabItem>
                    <views:SettingsPage />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
